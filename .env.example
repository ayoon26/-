# Sprout — environment configuration
#
# This build ships as a static, mobile-first single-page app with a fully
# client-side Demo Mode. Nothing below is read by the current codebase —
# there is no backend yet. These variables document what a Connected Mode
# backend would need once one exists (see README.md "Connected Mode / Plaid
# Sandbox setup" for the full runbook). Keep them here so the shape of a
# production deployment is explicit and reviewable.

# --- Database (Prisma + PostgreSQL), for a future backend ---
DATABASE_URL="postgresql://user:password@localhost:5432/sprout"

# --- Auth (Supabase Auth or Clerk), for a future backend ---
# Pick one provider; this build's client-side "sign in" screen is a
# same-device stand-in and does not use either of these.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# — or —
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Plaid Sandbox, for a future backend ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_WEBHOOK_URL=""

# --- Application-layer token encryption, for a future backend ---
# Access tokens returned by Plaid must be encrypted before they touch a
# database. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Observability (optional) ---
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"
